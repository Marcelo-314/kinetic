          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "const status = pm.collectionVariables.get('process_status');",
                  "pm.test('Results semantics align with process status', function () {",
                  "  if (status === 'PENDING') pm.expect(body.result_kind).to.eql('NONE');",
                  "  if (['RUNNING','PAUSED','FAILED','STOPPED'].includes(status)) pm.expect(['PARTIAL','NONE']).to.include(body.result_kind);",
                  "  if (status === 'COMPLETED') pm.expect(body.result_kind).to.eql('FINAL');",
                  "});"
