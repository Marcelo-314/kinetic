      "name": "00 - Bootstrap",
      "description": "Base setup and smoke creation requests.",
      "item": [
        {
          "name": "Create Process - Explicit Selection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/processes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "processes"
              ]
            },
            "description": "Creates a process and stores process_id for downstream requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objective\": \"analyze selected documents for lexical metrics and summary\",\n  \"source_folder\": \"{{source_folder}}\",\n  \"selection_mode\": \"EXPLICIT_SELECTION\",\n  \"selected_files\": [\n    \"{{selected_file_1}}\",\n    \"{{selected_file_2}}\"\n  ],\n  \"batch_size\": 1,\n  \"summary_policy\": \"{{summary_policy}}\",\n  \"failure_policy\": \"{{failure_policy}}\",\n  \"authorization_required\": true\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Process is created in PENDING', function () { pm.expect(body.status).to.eql('PENDING'); });",
                  "pm.test('Authorization starts in WAITING', function () { pm.expect(body.authorization.authorization_state).to.eql('WAITING'); });",
                  "pm.collectionVariables.set('process_id', body.process_id);",
                  "pm.collectionVariables.set('pending_process_id', body.process_id);",
                  "pm.collectionVariables.set('process_status', body.status);",
                  "pm.collectionVariables.set('result_kind', 'NONE');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Process Status - Smoke",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
