                  "pm.collectionVariables.set('target_status', 'PAUSED');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Poll Status Until Target State",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/processes/{{process_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "processes",
                "{{process_id}}",
                "status"
              ]
            },
            "description": "Reusable polling request. Set collection variable target_status before executing."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "const target = pm.collectionVariables.get('target_status');",
                  "const maxRetries = Number(pm.collectionVariables.get('max_retries') || 12);",
                  "let retries = Number(pm.collectionVariables.get('retries') || 0);",
                  "pm.collectionVariables.set('process_status', body.status);",
                  "if (body.status !== target && retries < maxRetries) {",
                  "  retries += 1;",
                  "  pm.collectionVariables.set('retries', String(retries));",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.unset('retries');",
                  "  postman.setNextRequest(null);",
                  "}",
                  "pm.test('Status eventually reaches target or max retries', function () {",
                  "  pm.expect(retries).to.be.at.most(maxRetries);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
